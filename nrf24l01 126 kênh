byte nrfStartCh = 0;
byte nrfEndCh = 83;      // Mặc định ban đầu dải 0 - 83
int nrfRangeMode = 0;    // 0: 0-83, 1: 84-125
int ptr_hop = 0;

#define MAX_NRF_LOGS 30
char nrfLogHistory[MAX_NRF_LOGS][28];
int nrfLogTotal = 0;
int nrfScrollPos = 0; 
bool nrfActive = false;  // Mặc định PAUSED khi mới vào

void pushNrfLog(const char* msg) {
  if (nrfLogTotal < MAX_NRF_LOGS) {
    strncpy(nrfLogHistory[nrfLogTotal], msg, 27);
    nrfLogHistory[nrfLogTotal][27] = '\0';
    nrfLogTotal++;
  } else {
    for (int i = 0; i < MAX_NRF_LOGS - 1; i++) {
      strcpy(nrfLogHistory[i], nrfLogHistory[i + 1]);
    }
    strncpy(nrfLogHistory[MAX_NRF_LOGS - 1], msg, 27);
    nrfLogHistory[MAX_NRF_LOGS - 1][27] = '\0';
  }

  if (nrfActive) {
    if (nrfLogTotal > 4) nrfScrollPos = nrfLogTotal - 4;
    else nrfScrollPos = 0;
  }
}

