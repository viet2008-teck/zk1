// ==========================================
// 5. CÁC HÀM XỬ LÝ PHẦN CỨNG
// ==========================================
void nrfSPIInit() {
  fspi.begin(SPI_SCK, SPI_MISO, SPI_MOSI, NRF_CSN_PIN);
  if (radio.begin(&fspi)) {
    radio.setAutoAck(false);
    radio.stopListening();
    radio.setRetries(0, 0);
    radio.setPayloadSize(31);
    radio.setAddressWidth(4);
    
    radio.setPALevel(RF24_PA_MAX, true); // Công suất cực đại (0 dBm)
    radio.setDataRate(RF24_2MBPS);
    radio.setCRCLength(RF24_CRC_DISABLED);
    radio.startConstCarrier(RF24_PA_MAX, 45); 
    
    nrfHardwareOK = radio.isChipConnected();
  } else {
    nrfHardwareOK = false;
  }
}

void startOrPauseTimer() {
  if (timerRunning) {
    accumulatedTime += (millis() - timerStartMark);
    timerRunning = false;
  } else {
    timerStartMark = millis();
    timerRunning = true;
  }
}

void resetTimer() {
  accumulatedTime = 0;
  timerStartMark = millis();
}

void updateTimerString() {
  unsigned long currentElapsed = accumulatedTime;
  if (timerRunning) currentElapsed += (millis() - timerStartMark);

  unsigned long tenths = (currentElapsed / 100) % 10;
  unsigned long totalSecs = currentElapsed / 1000;
  unsigned long secs = totalSecs % 60;
  unsigned long totalMins = totalSecs / 60;
  unsigned long mins = totalMins % 60;
  unsigned long hours = totalMins / 60;

  snprintf(timerStr, sizeof(timerStr), "%02lu:%02lu:%02lu:%1lu", hours, mins, secs, tenths);
}

void updateGameTimerString() {
  unsigned long tenths = (gamePlayTime / 100) % 10;
  unsigned long totalSecs = gamePlayTime / 1000;
  unsigned long secs = totalSecs % 60;
  unsigned long mins = (totalSecs / 60) % 60;

  snprintf(gameTimerStr, sizeof(gameTimerStr), "%02lu:%02lu:%1lu", mins, secs, tenths);
}

void resetGame() {
  dinoY = GROUND_Y;
  dinoVel = 0;
  isJumping = false;
  cactusX = 128;
  score = 0;
  gameOver = false;
  gameStartTime = millis();
  gamePlayTime = 0;
  updateGameTimerString();
}

