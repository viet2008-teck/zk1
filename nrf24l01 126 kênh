// ==========================================
// 6. XỬ LÝ NHẤN NHANH (SHORT PRESS)
// ==========================================
void handleShortPress(uint8_t btnId) {
  if (btnId == 4) {
    if (currentMode == MODE_GAME) {
      if (!isJumping && !gameOver) {
        dinoVel = -5.2;
        isJumping = true;
      } else if (gameOver) {
        resetGame();
      }
    } else if (currentMode == MODE_STOPWATCH) {
      startOrPauseTimer();
    } else if (currentMode == MODE_NRF24) {
      int maxScroll = (nrfLogTotal > 4) ? (nrfLogTotal - 4) : 0;
      if (nrfScrollPos < maxScroll) {
        nrfScrollPos++;
      }
    }
  } else if (btnId == 5) {
    if (currentMode == MODE_GAME) {
      if (gameOver) resetGame();
    } else if (currentMode == MODE_STOPWATCH) {
      resetTimer();
    } else if (currentMode == MODE_NRF24) {
      if (nrfScrollPos > 0) {
        nrfScrollPos--;
      }
    } else if (currentMode == MODE_MENU) {
      showMiniTable = !showMiniTable;
    }
  }
}

// ==========================================
// 7. XỬ LÝ NHẤN GIỮ (HOLD LOADING & TIMING)
// ==========================================
void checkAndProcessButtons() {
  uint8_t activeBtn = 0;
  if (digitalRead(BTN_1_PIN) == LOW) activeBtn = 4;
  else if (digitalRead(BTN_2_PIN) == LOW) activeBtn = 5;

  if (activeBtn == 0) return;

  uint8_t pin = (activeBtn == 4) ? BTN_1_PIN : BTN_2_PIN;
  delay(25); 
  if (digitalRead(pin) != LOW) return;

  unsigned long start = millis();

  while (digitalRead(pin) == LOW) {
    unsigned long duration = millis() - start;

    // Thời gian tối đa để tính % (Nút 5 ở chế độ NRF cần 5 giây = 5000ms)
    unsigned long maxHoldTime = 3000;
    if (activeBtn == 5 && currentMode == MODE_NRF24) {
      maxHoldTime = 5000; 
    }

    if (duration > 180) {
      int percent = map(duration, 0, maxHoldTime, 0, 100);
      if (percent > 100) percent = 100;

      u8g2.clearBuffer();
      u8g2.setFont(u8g2_font_micro_tr);
      u8g2.drawStr(42, 12, "HOLD LOADING");

      u8g2.drawFrame(12, 22, 104, 16);
      u8g2.drawFrame(10, 20, 108, 20);
      u8g2.drawHLine(14, 16, 100);
      u8g2.drawHLine(14, 44, 100);

      int fillW = map(percent, 0, 100, 0, 100);
      u8g2.drawBox(14, 24, fillW, 12);

      u8g2.setCursor(8, 58); u8g2.print(percent); u8g2.print("%");
      u8g2.setCursor(98, 58); u8g2.print(percent); u8g2.print("%");

      u8g2.setCursor(18, 58);
      if (activeBtn == 4) {
        if (currentMode == MODE_NRF24) {
          if (percent >= 20 && percent <= 50) {
            if (!nrfHardwareOK) u8g2.print("> LOCKED (NRF NO) <");
            else u8g2.print(nrfActive ? "> TAM NGUNG <" : "> TIEP TUC <");
          } else {
            u8g2.print("GIU DE RUN/PAUSE");
          }
        } else {
          if (percent < 20) u8g2.print("GIU TIEP...");
          else if (percent >= 20 && percent <= 45) u8g2.print("> VAO GAME <");
          else if (percent > 45 && percent < 70) u8g2.print("GIU DEN 70%");
          else u8g2.print("> NRF24 ATOM <");
        }
      } else if (activeBtn == 5) {
        if (currentMode == MODE_NRF24) {
          if (percent < 25) u8g2.print("GIU DEN 100% (5S)");
          else if (percent >= 25 && percent <= 50) u8g2.print("> TRANG CHU <");
          else if (percent > 50 && percent < 90) u8g2.print("GIU TIEP 5S...");
          else {
            if (nrfRangeMode == 0) u8g2.print("> DOI DAI 84-125 <");
            else                   u8g2.print("> DOI DAI 0-83 <");
          }
        } else {
          if (percent < 20) u8g2.print("GIU TIEP...");
          else if (percent >= 20 && percent <= 45) u8g2.print("> DONG HO <");
          else if (percent >= 50 && percent <= 75) u8g2.print("> TRANG CHU <");
          else u8g2.print("THA TAY RA");
        }
      }

      u8g2.sendBuffer();
    }
    delay(15);
  }

  unsigned long totalHold = millis() - start;

  if (totalHold < 350) {
    handleShortPress(activeBtn);
  } else {
    if (activeBtn == 4) {
      int percent = map(totalHold, 0, 3000, 0, 100);
      if (currentMode == MODE_NRF24) {
        if (percent >= 20 && percent <= 50) {
          if (nrfHardwareOK) {
            nrfActive = !nrfActive;
            if (nrfActive) pushNrfLog("> SWEEP RUNNING");
            else pushNrfLog("> PAUSED SWEEPING");
          } else {
            nrfActive = false;
            pushNrfLog("! ERR: NRF NO (LOCKED)");
          }
        }
      } else {
        if (percent >= 20 && percent <= 45) {
          showMiniTable = false;
          currentMode = MODE_GAME;
          resetGame();
        } else if (percent >= 70) {
          showMiniTable = false;
          showAtomAnimation();
          currentMode = MODE_NRF24;
          nrfActive = false; 
          
          // MẶC ĐỊNH VÀO LÀ DẢI 0-83
          nrfRangeMode = 0;
          nrfStartCh = 0;
          nrfEndCh = 83;
          ptr_hop = nrfStartCh;

          if (nrfHardwareOK) pushNrfLog("> NRF24 [0-83] Ready");
          else pushNrfLog("! ERR: NRF24 Hardware NO");
        }
      }
    } else if (activeBtn == 5) {
      if (currentMode == MODE_NRF24) {
        int percent5s = map(totalHold, 0, 5000, 0, 100);
        
        // Nhấn giữ đủ 5s (>= 90% của 5000ms) để chuyển dải
        if (percent5s >= 90) {
          nrfRangeMode = (nrfRangeMode == 0) ? 1 : 0;
          if (nrfRangeMode == 0) {
            nrfStartCh = 0;
            nrfEndCh = 83;
            pushNrfLog("> CH: 0-83 (2.4G Wi-Fi/BT)");
          } else {
            nrfStartCh = 84;
            nrfEndCh = 125;
            pushNrfLog("> CH: 84-125 (High-Band)");
          }
          ptr_hop = nrfStartCh;
        } 
        // Nhấn giữ ngắn hơn (25% - 50% của 5s) để về TRANG CHỦ
        else if (percent5s >= 25 && percent5s <= 50) {
          showMiniTable = false;
          currentMode = MODE_MENU;
        }
      } else {
        int percent3s = map(totalHold, 0, 3000, 0, 100);
        if (percent3s >= 20 && percent3s <= 45) {
          showMiniTable = false;
          currentMode = MODE_STOPWATCH;
        } else if (percent3s >= 50 && percent3s <= 75) {
          showMiniTable = false;
          currentMode = MODE_MENU;
        }
      }
    }
  }
}

