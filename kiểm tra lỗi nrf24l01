void setup() {
  Serial.begin(115200);
  pinMode(BTN_1_PIN, INPUT_PULLUP);
  pinMode(BTN_2_PIN, INPUT_PULLUP);

  Wire.begin(SDA_PIN, SCL_PIN);
  u8g2.begin();
  u8g2.setBusClock(800000);

  nrfSPIInit();
  runBootAnimation();

  pushNrfLog("> System Initialized");
}

// ==========================================
// 8. LOOP CHÍNH
// ==========================================
void loop() {
  checkAndProcessButtons();
  updateTimerString();

  // --- 1. MÀN HÌNH MENU ---
  if (currentMode == MODE_MENU) {
    u8g2.clearBuffer();
    u8g2.drawXBMP(6, 12, 32, 32, android_logo_bmp);
    
    u8g2.setFont(u8g2_font_7x14_tr);
    u8g2.drawStr(44, 18, "REDMAGIC");

    u8g2.setFont(u8g2_font_5x7_tr);
    u8g2.drawStr(44, 30, "Giu N4 1s: Vao Game");
    u8g2.drawStr(44, 40, "Giu N4 3s: Vao NRF24");
    u8g2.drawStr(44, 50, "Giu N5 1s: Vao Timer");

    u8g2.drawHLine(0, 63, 128);

    if (showMiniTable) drawMiniTableOverlay();

    u8g2.sendBuffer();
    return;
  }

  // --- 2. CHẾ ĐỘ NRF24 SWEEPER ---
  if (currentMode == MODE_NRF24) {
    // KIỂM TRA PHẦN CỨNG LIÊN TỤC TRONG LOOP
    nrfHardwareOK = radio.isChipConnected();

    // NẾU MẤT KẾT NỐI KHI ĐANG CHẠY -> TỰ ĐỘNG TẠM NGỪNG NGAY LẬP TỨC
    if (!nrfHardwareOK && nrfActive) {
      nrfActive = false;
      pushNrfLog("! LOST NRF: AUTO STOP");
    }

    // CHỈ QUÉT KHI CÓ KẾT NỐI (OK) VÀ TRẠNG THÁI ĐANG BẬT (RUNNING)
    if (nrfActive && nrfHardwareOK) {
      ptr_hop = (ptr_hop + 1) % sizeof(hopping_channel);
      byte currentChannel = hopping_channel[ptr_hop];
      radio.setChannel(currentChannel);

      char logBuf[28];
      snprintf(logBuf, sizeof(logBuf), "> CH:%02d | %dMHz [TX]", currentChannel, 2400 + currentChannel);
      pushNrfLog(logBuf);
    }

    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_micro_tr);
    
    // HIỂN THỊ TIÊU ĐỀ THEO TRẠNG THÁI REAL-TIME
    if (nrfHardwareOK) {
      if (nrfActive) u8g2.drawStr(0, 7, "NRF24 [OK]: [RUNNING]");
      else           u8g2.drawStr(0, 7, "NRF24 [OK]: [PAUSED]");
    } else {
      u8g2.drawStr(0, 7, "NRF24 [NO]: [DISCONNECTED]");
    }
    
    u8g2.drawHLine(0, 9, 128);

    u8g2.setFont(u8g2_font_5x7_tr);
    for (int i = 0; i < 4; i++) {
      int lineIdx = nrfScrollPos + i;
      if (lineIdx < nrfLogTotal) {
        u8g2.drawStr(0, 20 + (i * 10), nrfLogHistory[lineIdx]);
      }
    }

    u8g2.drawHLine(0, 53, 128);
    u8g2.setFont(u8g2_font_micro_tr);
    u8g2.drawStr(0, 62, "N4 1s: Run/Pause | N4/N5: Scroll");

    u8g2.sendBuffer();
    delay(nrfActive ? 20 : 50);
    return;
  }

  // --- 3. CHẾ ĐỘ BẤM GIỜ ---
  if (currentMode == MODE_STOPWATCH) {
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_6x10_tr);
    u8g2.drawStr(24, 12, "REDMAGIC TIMER");

    u8g2.setFont(u8g2_font_10x20_tr);
    u8g2.setCursor(14, 38);
    u8g2.print(timerStr);

    u8g2.setFont(u8g2_font_5x7_tr);
    u8g2.setCursor(20, 52);
    if (timerRunning) u8g2.print("[ DANG CHAY... ]");
    else u8g2.print("[ TAM DUNG ]");

    u8g2.drawStr(0, 64, "N4:Chay/Dung | N5:Reset");

    u8g2.sendBuffer();
    return;
  }

  // --- 4. CHẾ ĐỘ GAME KHỦNG LONG ---
  if (currentMode == MODE_GAME) {
    if (gameOver) {
      u8g2.clearBuffer();
      u8g2.setFont(u8g2_font_6x10_tr);
      u8g2.drawStr(32, 16, "GAME OVER");
      
      u8g2.setCursor(10, 36); u8g2.print("Diem dat duoc: "); u8g2.print(score);
      u8g2.setCursor(10, 52); u8g2.print("Thoi gian: "); u8g2.print(gameTimerStr);
      
      u8g2.sendBuffer();
      return;
    }

    gamePlayTime = millis() - gameStartTime;
    updateGameTimerString();

    dinoY += dinoVel;
    dinoVel += 0.45;
    if (dinoY >= GROUND_Y) {
      dinoY = GROUND_Y;
      isJumping = false;
    }

    cactusX -= FIXED_SPEED;
    if (cactusX < -12) {
      cactusX = 128;
      score++;
    }

    if (10 + 12 > cactusX && 10 < cactusX + 10 && dinoY + 14 > 48) {
      gameOver = true;
    }

    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_micro_tr);
    u8g2.drawStr(0, 8, "REDMAGIC");
    u8g2.setCursor(48, 8); u8g2.print("S:"); u8g2.print(score);
    u8g2.setCursor(85, 8); u8g2.print(gameTimerStr);

    u8g2.drawHLine(0, 10, 128);
    u8g2.drawHLine(0, 62, 128);
    u8g2.drawXBMP(10, dinoY, 16, 16, dino_bmp);
    u8g2.drawXBMP((int)cactusX, 48, 12, 14, cactus_bmp);

    u8g2.sendBuffer();
    delay(10);
  }
}
