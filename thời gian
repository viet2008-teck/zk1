  u8g2.drawStr(12, 24, "N4 Ngan");  u8g2.drawStr(52, 24, "Nhay / Run");
  u8g2.drawStr(12, 37, "N5 Ngan");  u8g2.drawStr(52, 37, "Reset/Pause");
