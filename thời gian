// --- KHỞI ĐỘNG: REDMAGIC TRƯỚC -> LOGO ANDROID SAU ---
void runBootAnimation() {
  // 1. Màn hình 1: Hiện chữ REDMAGIC
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_ncenB14_tr);
  u8g2.drawStr(10, 40, "REDMAGIC");
  u8g2.sendBuffer();
  delay(1500);

  // 2. Màn hình 2: Hiện Logo Android
  u8g2.clearBuffer();
  u8g2.drawXBMP(12, 16, 32, 32, android_logo_bmp);
  u8g2.setFont(u8g2_font_7x14_tr);
  u8g2.drawStr(52, 32, "REDMAGIC");
  u8g2.setFont(u8g2_font_5x7_tr);
  u8g2.drawStr(52, 44, "Android Ed.");
  u8g2.sendBuffer();
  delay(1800);

  currentMode = MODE_MENU;
}

void setup() {
  pinMode(BTN_1_PIN, INPUT_PULLUP);
  pinMode(BTN_2_PIN, INPUT_PULLUP);

  Wire.begin(SDA_PIN, SCL_PIN);
  u8g2.begin();
  u8g2.setBusClock(800000);

  runBootAnimation();
}

void loop() {
  updateButton(btn1);
  updateButton(btn2);
  updateTimerString();

  // --- NẤN GIỮ NÚT ĐỂ CHUYỂN MODE HẶC VỀ HOME ---
  if (btn2.longPressed) {
    showMiniTable = false;
    currentMode = MODE_MENU; // Quay về Menu
  }

  if (btn1.longPressed) {
    showMiniTable = false;
    if (currentMode == MODE_GAME) currentMode = MODE_STOPWATCH;
    else {
      currentMode = MODE_GAME;
      resetGame();
    }
  }

  // --- 1. MÀN HÌNH MENU CHÍNH ---
  if (currentMode == MODE_MENU) {
    if (btn1.shortPressed) {
      if (showMiniTable) showMiniTable = false;
      else { currentMode = MODE_GAME; resetGame(); }
    }
    if (btn2.shortPressed) {
      showMiniTable = !showMiniTable; // Bật / Tắt Bảng Bé
    }

    u8g2.clearBuffer();
    u8g2.drawXBMP(6, 12, 32, 32, android_logo_bmp);
    
    u8g2.setFont(u8g2_font_7x14_tr);
    u8g2.drawStr(44, 18, "REDMAGIC");

    u8g2.setFont(u8g2_font_5x7_tr);
    u8g2.drawStr(44, 30, "N4: Choi Game");
    u8g2.drawStr(44, 40, "N5: Bang Nut Be");
    u8g2.drawStr(44, 50, "Giu N1/2: Mode/Home");

    u8g2.drawHLine(0, 63, 128);

    if (showMiniTable) drawMiniTableOverlay();

    u8g2.sendBuffer();
    return;
  }

  // --- 2. CHẾ ĐỘ BẤM GIỜ ---
  if (currentMode == MODE_STOPWATCH) {
    if (btn1.shortPressed) startOrPauseTimer();
    if (btn2.shortPressed) resetTimer();

    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_6x10_tr);
    u8g2.drawStr(24, 12, "REDMAGIC TIMER");

    u8g2.setFont(u8g2_font_10x20_tr);
    u8g2.setCursor(14, 38);
    u8g2.print(timerStr);

    u8g2.setFont(u8g2_font_5x7_tr);
    u8g2.setCursor(20, 54);
    if (timerRunning) u8g2.print("[ DANG CHAY... ]");
    else u8g2.print("[ TAM DUNG ]");

    u8g2.drawStr(0, 64, "N4:Chay/Dung | N5:Reset");

    if (showMiniTable) drawMiniTableOverlay();

    u8g2.sendBuffer();
    return;
  }

  // --- 3. CHẾ ĐỘ GAME (TỐC ĐỘ CỐ ĐỊNH) ---
  if (currentMode == MODE_GAME) {
    if (gameOver) {
      if (btn1.shortPressed || btn2.shortPressed) resetGame();

      u8g2.clearBuffer();
      u8g2.setFont(u8g2_font_6x10_tr);
      u8g2.drawStr(32, 16, "GAME OVER");
      
      u8g2.setCursor(10, 36); u8g2.print("Diem dat duoc: "); u8g2.print(score);
      u8g2.setCursor(10, 52); u8g2.print("Thoi gian: "); u8g2.print(timerStr);
      
      if (showMiniTable) drawMiniTableOverlay();
      u8g2.sendBuffer();
      return;
    }

    if (btn1.shortPressed && !isJumping) {
      dinoVel = -5.2;
      isJumping = true;
    }

    if (btn2.shortPressed) startOrPauseTimer();

    // Vật lý nhảy
    dinoY += dinoVel;
    dinoVel += 0.45;
    if (dinoY >= GROUND_Y) {
      dinoY = GROUND_Y;
      isJumping = false;
    }

    // Tốc độ di chuyển xương rồng giữ nguyên hằng số
    cactusX -= FIXED_SPEED;
    if (cactusX < -12) {
      cactusX = 128;
      score++; // Tăng điểm nhưng KHÔNG tăng tốc độ nữa
    }

    // Va chạm
    if (10 + 12 > cactusX && 10 < cactusX + 10 && dinoY + 14 > 48) {
      gameOver = true;
    }

    // Vẽ Màn hình Game
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_micro_tr);
    u8g2.drawStr(0, 8, "REDMAGIC");
    u8g2.setCursor(48, 8); u8g2.print("S:"); u8g2.print(score);
    u8g2.setCursor(78, 8); u8g2.print(timerStr);

    u8g2.drawHLine(0, 10, 128);
    u8g2.drawHLine(0, 62, 128);
    u8g2.drawXBMP(10, dinoY, 16, 16, dino_bmp);
    u8g2.drawXBMP((int)cactusX, 48, 12, 14, cactus_bmp);

    if (showMiniTable) drawMiniTableOverlay();

    u8g2.sendBuffer();
    delay(10);
  }
}
