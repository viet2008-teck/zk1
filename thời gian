// --- BẤM GIỜ & GAME ---
unsigned long accumulatedTime = 0;
unsigned long timerStartMark = 0;
bool timerRunning = false;
char timerStr[16] = "00:00:00:0";

const int GROUND_Y = 46;
int dinoY = GROUND_Y;
float dinoVel = 0;
bool isJumping = false;
float cactusX = 128;

// TỐC ĐỘ CỐ ĐỊNH (Bạn có thể đổi số 3.0 thành 2.5 nếu muốn chậm hơn nữa)
const float FIXED_SPEED = 3.0; 
int score = 0;
bool gameOver = false;

// --- CẤU TRÚC PHÍM BẤM ---
struct Button {
  uint8_t pin;
  bool lastState;
  unsigned long pressStartTime;
  bool shortPressed;
  bool longPressed;
  bool longHandled;
};

Button btn1 = {BTN_1_PIN, HIGH, 0, false, false, false};
Button btn2 = {BTN_2_PIN, HIGH, 0, false, false, false};

void updateButton(Button &btn) {
  bool reading = digitalRead(btn.pin);
  btn.shortPressed = false;
  btn.longPressed = false;

  if (reading != btn.lastState) {
    if (reading == LOW) {
      btn.pressStartTime = millis();
      btn.longHandled = false;
    } else {
      if (!btn.longHandled && (millis() - btn.pressStartTime >= 35) && (millis() - btn.pressStartTime < 1000)) {
        btn.shortPressed = true;
      }
    }
  }

  if (reading == LOW && !btn.longHandled) {
    if (millis() - btn.pressStartTime >= 1000) { // Giữ 1 giây
      btn.longPressed = true;
      btn.longHandled = true;
    }
  }

  btn.lastState = reading;
}

// --- HÀM BẤM GIỜ ---
void startOrPauseTimer() {
  if (timerRunning) {
    accumulatedTime += (millis() - timerStartMark);
    timerRunning = false;
  } else {
    timerStartMark = millis();
    timerRunning = true;
  }
}

void resetTimer() {
  accumulatedTime = 0;
  timerStartMark = millis();
}

void updateTimerString() {
  unsigned long currentElapsed = accumulatedTime;
  if (timerRunning) {
    currentElapsed += (millis() - timerStartMark);
  }

  unsigned long tenths = (currentElapsed / 100) % 10;
  unsigned long totalSecs = currentElapsed / 1000;
  unsigned long secs = totalSecs % 60;
  unsigned long totalMins = totalSecs / 60;
  unsigned long mins = totalMins % 60;
  unsigned long hours = totalMins / 60;

  snprintf(timerStr, sizeof(timerStr), "%02lu:%02lu:%02lu:%1lu", hours, mins, secs, tenths);
}

void resetGame() {
  dinoY = GROUND_Y;
  dinoVel = 0;
  isJumping = false;
  cactusX = 128;
  score = 0;
  gameOver = false;
}

